# ── LiteLLM ────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-boss-man-master-key-change-me
LITELLM_SALT_KEY=salt-change-me
LITELLM_PORT=4000

# ── Provider API keys ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Postgres (LiteLLM backend) ──────────────────────────────────────────────
POSTGRES_PASSWORD=litellm-postgres-pw-change-me

# ── Dolt (Beads backend) ────────────────────────────────────────────────────
DOLT_PORT=3306
DOLT_ROOT_PASSWORD=dolt-root-pw-change-me
DOLT_HOST=127.0.0.1

# ── Langfuse ────────────────────────────────────────────────────────────────
LANGFUSE_PORT=3000
LANGFUSE_DB_PASSWORD=langfuse-postgres-pw-change-me
LANGFUSE_NEXTAUTH_SECRET=langfuse-nextauth-secret-change-me
LANGFUSE_SALT=langfuse-salt-change-me
LANGFUSE_ENCRYPTION_KEY=langfuse-encryption-key-0000000000000000000000000000000
LANGFUSE_SECRET_KEY=sk-lf-secret-change-me
LANGFUSE_PUBLIC_KEY=pk-lf-public-change-me
LANGFUSE_HOST=http://localhost:3000

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=3001
NODE_ENV=development

# ── Agent defaults ──────────────────────────────────────────────────────────
# Model routing: high=opus-4-7, medium=sonnet-4-6, low=haiku-4-5
DEFAULT_AGENT_PROVIDER=claude-code
DEFAULT_AGENT_MODEL=boss-man/medium
SANDBOX_IMAGE=boss-man:sandbox

# ── Beads ────────────────────────────────────────────────────────────────────
BEADS_STORE_HOST=127.0.0.1
BEADS_STORE_PORT=3306
BEADS_STORE_PASSWORD=dolt-root-pw-change-me
