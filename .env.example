# ── LiteLLM ────────────────────────────────────────────────────────────────
# Shared key across all local projects (ao-briefcase, boss-man, etc.)
# Must match ao-briefcase's LITELLM_MASTER_KEY if reusing that instance.
LITELLM_MASTER_KEY=sk-bigpickleman
LITELLM_SALT_KEY=sk-1234
LITELLM_PORT=4000
# Virtual/client key agents use to authenticate to LiteLLM.
# This may differ from LITELLM_MASTER_KEY when reusing an existing LiteLLM.
LITELLM_API_KEY=sk-bigpickleman

# Claude Code auth routing:
# - UI "Anthropic": uses claude-code with CLAUDE_CODE_OAUTH_TOKEN.
# - UI "LiteLLM": uses claude-code with ANTHROPIC_BASE_URL/ANTHROPIC_API_KEY
#   overridden to point at LiteLLM and authenticate with LITELLM_API_KEY.
# CLAUDE_CODE_AUTH_MODE remains as a server default for non-UI runs.
CLAUDE_CODE_AUTH_MODE=login
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_HIGH_MODEL=opus
CLAUDE_CODE_MEDIUM_MODEL=sonnet
CLAUDE_CODE_LOW_MODEL=sonnet

# ── Provider API keys ───────────────────────────────────────────────────────
# Required for standalone LiteLLM mode. Get from console.anthropic.com.
# Claude Code subscription/OAuth tokens from `claude setup-token` belong in
# CLAUDE_CODE_OAUTH_TOKEN, not ANTHROPIC_API_KEY.
# Not needed if reusing ao-briefcase's LiteLLM instance.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Postgres (LiteLLM backend — standalone mode only) ───────────────────────
# Generated by install.sh
POSTGRES_PASSWORD=

# ── Langfuse — runs on :3002 to avoid collision with mr-robot's :3000 ───────
LANGFUSE_PORT=3002
LANGFUSE_HOST=http://localhost:3002
# Generated by install.sh
LANGFUSE_DB_PASSWORD=
# Shared with mr-robot's Langfuse instance for unified trace history
LANGFUSE_NEXTAUTH_SECRET=+MjTkNXv8u/gjy2VjeS/OyBXfLEDDAyH9t66PQwOcmU=
LANGFUSE_SALT=b/X1PfIRo0wcKv1gwYQzcdKCFCXoOJwxl3NctyMR8Xs=
LANGFUSE_ENCRYPTION_KEY=688294c7b2c0611607756a97ce3a588a9df7807d1bcf9411ea2cb0c7fdf1b4d5
LANGFUSE_SECRET_KEY=lf-sk-mr-robot-local
LANGFUSE_PUBLIC_KEY=lf-pk-mr-robot-local
# Seeds the initial org/project/user on first boot — change after first login
LANGFUSE_ADMIN_EMAIL=nader.kirrish@gmail.com
LANGFUSE_ADMIN_PASSWORD=picklespickles

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=3001
NODE_ENV=development

# ── Agent defaults ──────────────────────────────────────────────────────────
# claude-code+login uses Claude subscription auth mounted from ~/.claude.
# codex/opencode use LiteLLM through OPENAI_BASE_URL/OPENAI_API_KEY.
DEFAULT_AGENT_PROVIDER=claude-code
DEFAULT_AGENT_MODEL=boss-man/high
SANDBOX_IMAGE=boss-man:sandbox

